{
  "manifest_version": 3,
  "name": "Restyle",
  "version": "1.0.0",
  "description": "Restyle - Customize any website with your own CSS",
  "homepage_url": "https://github.com/unlibra/x-layer",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Restyle を開く",
    "default_icon": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_start"
    }
  ]
}
